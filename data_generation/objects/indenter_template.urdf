<?xml version="1.0"?>
<!-- Single-link URDF for one indenter. Copy to objects/<name>_indenter.urdf and point both meshes to the
     STL exported from SOLIDWORKS (cad/solidworks/*.SLDPRT). The scale converts millimetres to metres. -->
<robot name="hexagonal_indenter">
  <link name="indenter">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/hexagonal_indenter.stl" scale="0.001 0.001 0.001"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/hexagonal_indenter.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
  </link>
</robot>
